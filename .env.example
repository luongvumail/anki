# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Gemini AI Cloudflare Worker Proxy (Recommended for security - hides API key from client bundle)
EXPO_PUBLIC_AI_PROXY_URL=https://anki-gemini-proxy.your-subdomain.workers.dev
EXPO_PUBLIC_APP_TOKEN=your_secret_token

# Fallback: Direct Gemini API key (Only if not using Cloudflare Proxy - WARNING: Exposes key in binary bundle)
# EXPO_PUBLIC_GEMINI_API_KEY=AIzaSy...